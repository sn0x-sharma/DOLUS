[Unit]
Description=DOLUS SSH Honeypot & Attack Intelligence
Documentation=https://github.com/dolus/dolus
After=network.target
Wants=network.target

[Service]
Type=notify
User=dolus
Group=dolus
RuntimeDirectory=dolus
RuntimeDirectoryMode=0750
StateDirectory=dolus
StateDirectoryMode=0750
LogsDirectory=dolus
LogsDirectoryMode=0750
CacheDirectory=dolus
CacheDirectoryMode=0750

ExecStartPre=/usr/local/bin/dolus --config /etc/dolus/dolus.conf config
ExecStart=/usr/local/bin/dolus --config /etc/dolus/dolus.conf start
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/usr/local/bin/dolus --config /etc/dolus/dolus.conf stop
ExecStopPost=/bin/rm -f /var/run/dolus/dolus.pid

PIDFile=/var/run/dolus/dolus.pid
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
LimitMEMLOCK=0

# Capabilities (only what's needed for binding to privileged ports if required)
# AmbientCapabilities=CAP_NET_BIND_SERVICE
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target